# Application Config
PORT=5000
NODE_ENV=development
APP_NAME="DnyanX Ultimate Business OS"
APP_URL=http://localhost:5000

# Security & CORS
CORS_ORIGIN=*

# WhatsApp Cloud API & Webhook Configuration
WHATSAPP_VERIFY_TOKEN=dnyanx_secure_verify_token_2026
WHATSAPP_API_TOKEN=your_meta_whatsapp_cloud_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Firebase Admin SDK Configuration
# Option A: Path to serviceAccountKey.json (local dev only - git ignored)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Direct Environment Variables (Production & CI/CD)
FIREBASE_PROJECT_ID=dnyanx-business-os
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@dnyanx-business-os.iam.gserviceaccount.com
# Use escaped \n for private key in single line if set as ENV
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
