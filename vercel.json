{
  "version": 2,
  "rewrites": [
    {
      "source": "/store/:slug",
      "destination": "/store.html"
    },
    {
      "source": "/catalog",
      "destination": "/store.html"
    },
    {
      "source": "/biz/:slug",
      "destination": "/biz.html"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
